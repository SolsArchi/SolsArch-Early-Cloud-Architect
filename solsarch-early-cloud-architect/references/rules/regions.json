{
  "_comment": "Which geography a region id lies in. First matching pattern wins. geos: eu (European Union), eea (EU plus Norway, Iceland, Liechtenstein), uk, us, ca, in, au, jp, sg, ch, de, fr, br, kr, za, ae. Patterns are plain prefixes (^) or exact ids ($). Unknown regions are reported NOT_VERIFIED, never guessed.",
  "regions": [
    {"re": "^eu-west-2$", "geos": ["uk"], "label": "AWS London"},
    {"re": "^eu-west-3$", "geos": ["eu", "eea", "fr"], "label": "AWS Paris"},
    {"re": "^eu-central-1$", "geos": ["eu", "eea", "de"], "label": "AWS Frankfurt"},
    {"re": "^eu-central-2$", "geos": ["ch"], "label": "AWS Zurich"},
    {"re": "^eu-(west|north|south)-\\d$", "geos": ["eu", "eea"], "label": "AWS Europe"},
    {"re": "^us-", "geos": ["us"], "label": "AWS United States"},
    {"re": "^ca-", "geos": ["ca"], "label": "AWS Canada"},
    {"re": "^ap-south-", "geos": ["in"], "label": "AWS India"},
    {"re": "^ap-southeast-1$", "geos": ["sg"], "label": "AWS Singapore"},
    {"re": "^ap-southeast-2$", "geos": ["au"], "label": "AWS Sydney"},
    {"re": "^ap-northeast-", "geos": ["jp"], "label": "AWS Asia Pacific North-East"},
    {"re": "^sa-", "geos": ["br"], "label": "AWS South America"},
    {"re": "^af-", "geos": ["za"], "label": "AWS Africa"},
    {"re": "^me-", "geos": ["ae"], "label": "AWS Middle East"},
    {"re": "^europe-west2$", "geos": ["uk"], "label": "Google London"},
    {"re": "^europe-west3$", "geos": ["eu", "eea", "de"], "label": "Google Frankfurt"},
    {"re": "^europe-west9$", "geos": ["eu", "eea", "fr"], "label": "Google Paris"},
    {"re": "^europe-west6$", "geos": ["ch"], "label": "Google Zurich"},
    {"re": "^europe-", "geos": ["eu", "eea"], "label": "Google Europe"},
    {"re": "^us-", "geos": ["us"], "label": "Google United States"},
    {"re": "^northamerica-", "geos": ["ca"], "label": "Google Canada"},
    {"re": "^asia-south", "geos": ["in"], "label": "Google India"},
    {"re": "^asia-southeast1$", "geos": ["sg"], "label": "Google Singapore"},
    {"re": "^asia-northeast", "geos": ["jp"], "label": "Google Japan"},
    {"re": "^australia-", "geos": ["au"], "label": "Google Australia"},
    {"re": "^uksouth$|^ukwest$", "geos": ["uk"], "label": "Azure UK"},
    {"re": "^germany", "geos": ["eu", "eea", "de"], "label": "Azure Germany"},
    {"re": "^france", "geos": ["eu", "eea", "fr"], "label": "Azure France"},
    {"re": "^switzerland", "geos": ["ch"], "label": "Azure Switzerland"},
    {"re": "^norway", "geos": ["eea"], "label": "Azure Norway"},
    {"re": "^(westeurope|northeurope|swedencentral|italynorth|polandcentral|spaincentral|austriaeast)$", "geos": ["eu", "eea"], "label": "Azure Europe"},
    {"re": "^(eastus|eastus2|westus|westus2|westus3|centralus|northcentralus|southcentralus)$", "geos": ["us"], "label": "Azure United States"},
    {"re": "^(canadacentral|canadaeast)$", "geos": ["ca"], "label": "Azure Canada"},
    {"re": "^(centralindia|southindia|westindia)$", "geos": ["in"], "label": "Azure India"},
    {"re": "^(australiaeast|australiasoutheast)$", "geos": ["au"], "label": "Azure Australia"},
    {"re": "^(fsn1|nbg1)$", "geos": ["eu", "eea", "de"], "label": "Hetzner Germany"},
    {"re": "^hel1$", "geos": ["eu", "eea"], "label": "Hetzner Finland"},
    {"re": "^(ash|hil)$", "geos": ["us"], "label": "Hetzner United States"},
    {"re": "^sin$", "geos": ["sg"], "label": "Hetzner Singapore"},
    {"re": "^(gra|sbg|rbx|par|waw|lim|gra\\d|sbg\\d|rbx\\d|waw\\d|de1|uk1)$", "geos": ["eu", "eea"], "label": "OVHcloud Europe"},
    {"re": "^(fr-par|nl-ams|pl-waw)(-\\d)?$", "geos": ["eu", "eea"], "label": "Scaleway Europe"},
    {"re": "^(de-fra\\d|fi-hel\\d|nl-ams\\d|es-mad\\d|pl-waw\\d|se-sto\\d)$", "geos": ["eu", "eea"], "label": "UpCloud Europe"},
    {"re": "^(uk-lon\\d)$", "geos": ["uk"], "label": "UpCloud London"},
    {"re": "^(us-nyc\\d|us-chi\\d|us-sjo\\d)$", "geos": ["us"], "label": "UpCloud United States"},
    {"re": "^(ch-gva-2|ch-dk-2)$", "geos": ["ch"], "label": "Exoscale Switzerland"},
    {"re": "^(de-fra-1|de-muc-1|at-vie-1|at-vie-2|bg-sof-1)$", "geos": ["eu", "eea"], "label": "Exoscale Europe"},
    {"re": "^(fra1|ams3|ams2)$", "geos": ["eu", "eea"], "label": "DigitalOcean Europe"},
    {"re": "^lon1$", "geos": ["uk"], "label": "DigitalOcean London"},
    {"re": "^(nyc1|nyc3|sfo2|sfo3|tor1)$", "geos": ["us"], "label": "DigitalOcean North America"},
    {"re": "^(fra|ams|cdg|mad|sto|waw|man)$", "geos": ["eu", "eea"], "label": "Vultr Europe"},
    {"re": "^lhr$", "geos": ["uk"], "label": "Vultr London"},
    {"re": "^(eu-west|eu-central)$", "geos": ["eu", "eea"], "label": "Linode Europe"}
  ],
  "defaults": {
    "eu": {"aws": "eu-central-1", "azure": "germanywestcentral", "gcp": "europe-west3", "hetzner": "fsn1"},
    "us": {"aws": "us-east-1", "azure": "eastus", "gcp": "us-central1"},
    "uk": {"aws": "eu-west-2", "azure": "uksouth", "gcp": "europe-west2"}
  },
  "geo_names": {
    "eu": "the European Union", "eea": "the European Economic Area", "uk": "the United Kingdom", "us": "the United States",
    "ca": "Canada", "in": "India", "au": "Australia", "jp": "Japan", "sg": "Singapore", "ch": "Switzerland", "de": "Germany",
    "fr": "France", "br": "Brazil", "kr": "South Korea", "za": "South Africa", "ae": "the Middle East"
  }
